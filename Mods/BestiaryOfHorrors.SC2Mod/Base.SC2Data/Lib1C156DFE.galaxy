bool lib1C156DFE_InitLib_completed = false;

void lib1C156DFE_InitLib () {
    if (lib1C156DFE_InitLib_completed) {
        return;
    }

    lib1C156DFE_InitLib_completed = true;

    lib1C156DFE_InitLibraries();
}

