//--------------------------------------------------------------------------------------------------
// Trigger: Convo - Rocks Scantipede
//--------------------------------------------------------------------------------------------------
bool gt_ConvoRocksScantipede_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_p1_USERS))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    VisRevealArea(1, EventUnitRegion(), 5.0, false);
    CameraPan(1, UnitGetPosition(UnitFromId(494724233)), 2.0, -1, 10.0, false);
    gv_pING_AREA_01_ROCKS_SCANTIPEDE = lib1C156DFE_gf_CreateUnitSelectCampaign("BriefingUnitSelectSmall", UnitGetPosition(gv_aREA_01ROCKSCANTIPEDE));
    TriggerEnable(gt_KillSelectionPingScantipede, true);
    TriggerQueueEnter();
    ConversationDataRun("BOH_Mission01_RockScantipede", PlayerGroupAll(), c_conversationSkipNone, true);
    TriggerQueueExit();
    Wait(2.0, c_timeGame);
    TriggerEnable(gt_KillSelectionPingScantipede, false);
    libNtve_gf_KillModel(gv_pING_AREA_01_ROCKS_SCANTIPEDE);
    return true;
}

