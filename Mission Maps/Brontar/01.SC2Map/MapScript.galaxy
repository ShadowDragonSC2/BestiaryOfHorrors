//--------------------------------------------------------------------------------------------------
// Trigger: Scene - Boss Elemental Intro - Setup
//--------------------------------------------------------------------------------------------------
bool gt_SceneBossElementalIntroSetup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_units;

    // Automatic Variable Declarations
    unitgroup auto3BF86976_g;
    int auto3BF86976_u;
    unit auto3BF86976_var;
    unitgroup auto5C56847B_g;
    int auto5C56847B_u;
    unit auto5C56847B_var;

    // Variable Initialization
    lv_units = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    SoundtrackPause(PlayerGroupAll(), c_soundtrackCategoryMusic, true, true);
    CinematicFade(false, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    lib1C156DFE_gf_CinematicModeTransition(true, PlayerGroupAll(), 1.5);
    CutsceneFade(false, 0.0, Color(0,0,0), 100.0, PlayerGroupAll(), true);
    CutsceneCreateNoPosition("Cutscenes\\Intro_Two_Boss.SC2Cutscene", PlayerGroupAll(), true);
    CinematicFade(true, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    libNtve_gf_GlobalCinematicSetting(true);
    auto3BF86976_g = lv_units;
    auto3BF86976_u = UnitGroupCount(auto3BF86976_g, c_unitCountAll);
    for (;; auto3BF86976_u -= 1) {
        auto3BF86976_var = UnitGroupUnitFromEnd(auto3BF86976_g, auto3BF86976_u);
        if (auto3BF86976_var == null) { break; }
        UnitIssueOrder(auto3BF86976_var, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        libNtve_gf_PauseUnit(auto3BF86976_var, true);
        libNtve_gf_ShowHideUnit(auto3BF86976_var, false);
    }
    gv_current_Cutscene = CutsceneLastCreated();
    WaitForCutsceneToEnd(gv_current_Cutscene);
    UnitSetPosition(gv_hERO, PointFromId(1865282616), false);
    auto5C56847B_g = lv_units;
    auto5C56847B_u = UnitGroupCount(auto5C56847B_g, c_unitCountAll);
    for (;; auto5C56847B_u -= 1) {
        auto5C56847B_var = UnitGroupUnitFromEnd(auto5C56847B_g, auto5C56847B_u);
        if (auto5C56847B_var == null) { break; }
        libNtve_gf_PauseUnit(auto5C56847B_var, false);
        libNtve_gf_ShowHideUnit(auto5C56847B_var, true);
    }
    CameraPan(gv_p1_USERS, UnitGetPosition(gv_hERO), 0.0, -1, 10.0, false);
    libNtve_gf_GlobalCinematicSetting(false);
    CutsceneFade(true, 0.0, Color(0,0,0), 100.0, PlayerGroupAll(), false);
    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    libNtve_gf_ShowHideUnit(gv_bOSS_STORM_ELEMENTAL, true);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    SoundtrackPause(PlayerGroupAll(), c_soundtrackCategoryMusic, false, true);
    Wait(1.0, c_timeReal);
    lib1C156DFE_gf_CinematicModeTransition(false, PlayerGroupAll(), 1.0);
    TriggerExecute(gt_BossStormElementalInitQ, true, false);
    return true;
}

