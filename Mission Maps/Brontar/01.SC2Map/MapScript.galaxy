    TriggerAddEventUnitRegion(gt_SceneBossElementalIntroSetup, UnitRefFromVariable("gv_hERO"), RegionFromId(11), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: into
//--------------------------------------------------------------------------------------------------
bool gt_into_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "nDLC_Music_Cue03", c_soundtrackCueAny, c_soundtrackIndexAny, true);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    libNtve_gf_GlobalCinematicSetting(true);
    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    CameraApplyInfo(1, CameraInfoFromId(1876192207), 0.0, -1, 10.0, true);
    CameraApplyInfo(1, CameraInfoFromId(505469056), 8.0, 0.0, 10.0, true);
    Wait(4.0, c_timeReal);
    TriggerExecute(gt_DropVassel, true, false);
    CameraShake(1, "Medium", "Earthquake", 0.35, 0.7, 3.0);
    Wait(4.0, c_timeReal);
    TriggerExecute(gt_ConvoIntroMission, true, true);
    return true;
}

