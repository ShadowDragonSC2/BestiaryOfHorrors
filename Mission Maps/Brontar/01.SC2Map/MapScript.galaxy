    gt_StormElementalMoving = TriggerCreate("gt_StormElementalMoving_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Storm Elemental - Attack Manager
//--------------------------------------------------------------------------------------------------
bool gt_StormElementalAttackManager_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_stage;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    while ((UnitIsAlive(gv_bOSS_STORM_ELEMENTAL) == true)) {
        if (((lv_stage >= 0) && (lv_stage <= 2))) {
            TriggerExecute(gt_StormElementalAttackVariant1, true, true);
        }
        else if (true) {
            TriggerExecute(gt_StormElementalAttackVariant2, true, true);
            lv_stage = 0;
            continue;
        }
        TriggerExecute(gt_StormElementalMoving, true, true);
        lv_stage += 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StormElementalAttackManager_Init () {
    gt_StormElementalAttackManager = TriggerCreate("gt_StormElementalAttackManager_Func");
}

