//--------------------------------------------------------------------------------------------------
// Trigger: Storm Elemental - Moving
//--------------------------------------------------------------------------------------------------
bool gt_StormElementalMoving_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv__point;
    order lv__ord;

    // Automatic Variable Declarations
    // Variable Initialization
    lv__point = libNtve_gf_PointOffsetTowardsPoint(UnitGetPosition(gv_bOSS_STORM_ELEMENTAL), MinF(DistanceBetweenPoints(UnitGetPosition(gv_bOSS_STORM_ELEMENTAL), UnitGetPosition(gv_hERO)), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StormElemental_Blast", "Range[" + IntToString(0) + "]", c_playerAny)), UnitGetPosition(gv_hERO));
    lv__ord = OrderTargetingPoint(AbilityCommand("StormElemental_Blast", 0), lv__point);

    // Actions
    if (!runActions) {
        return true;
    }

    if ((libNtve_gf_RandomPercent() <= 75.0)) {
        if (gv_currentPoint >= 3) {
            gv_currentPoint = 1;
        }
        else {
            gv_currentPoint = gv_currentPoint + 1;
        }
    }

    while (!((UnitOrderCount(gv_bOSS_STORM_ELEMENTAL) == 0))) {
        Wait(0.1, c_timeGame);
    }
    UnitIssueOrder(gv_bOSS_STORM_ELEMENTAL, OrderTargetingPoint(AbilityCommand("move", 0), PointFromName((gv_strpoint + " " + IntToString(gv_currentPoint)))), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    UnitIssueOrder(gv_bOSS_STORM_ELEMENTAL, lv__ord, c_orderQueueReplace);
    UnitIssueOrder(gv_bOSS_STORM_ELEMENTAL, OrderTargetingPoint(AbilityCommand("move", 4), PointFromId(824813908)), c_orderQueueAddToEnd);
    Wait(4.0, c_timeGame);
    return true;
}

